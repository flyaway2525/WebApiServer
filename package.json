{
  "name": "web-api-server-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build -w api && npm run build -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}